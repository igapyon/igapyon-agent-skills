{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igapyon-skill-compactor artifact evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "assertions", "reason", "notes"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pass", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "pass": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "reason": { "type": "string" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
